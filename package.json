    "build:canon-dict": "node scripts/build-canon-dict.mjs",
    "android:apk": "node scripts/release-android.mjs apk",
    "android:aab": "node scripts/release-android.mjs aab",
    "android:release": "node scripts/release-android.mjs both"
  },
  "dependencies": {
