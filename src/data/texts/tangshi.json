{
  "id": "tangshi",
  "title": "唐诗三百首",
  "author": "蘅塘退士编选",
  "category": "ji",
  "description": "唐诗选集，选录唐代诗人佳作，本书收录李白、杜甫、王维等名家作品三十六首。",
  "chapters": [
    { "id": "tangshi-jingyesi", "bookId": "tangshi", "title": "静夜思·李白", "order": 1, "segments": [{ "id": "tangshi-jingyesi-1", "chapterId": "tangshi-jingyesi", "order": 1, "text": "床前明月光，疑是地上霜。举头望明月，低头思故乡。" }] },
    { "id": "tangshi-wanglushanpubu", "bookId": "tangshi", "title": "望庐山瀑布·李白", "order": 2, "segments": [{ "id": "tangshi-wanglushanpubu-1", "chapterId": "tangshi-wanglushanpubu", "order": 1, "text": "日照香炉生紫烟，遥看瀑布挂前川。飞流直下三千尺，疑是银河落九天。" }] },
    { "id": "tangshi-zaofabaidicheng", "bookId": "tangshi", "title": "早发白帝城·李白", "order": 3, "segments": [{ "id": "tangshi-zaofabaidicheng-1", "chapterId": "tangshi-zaofabaidicheng", "order": 1, "text": "朝辞白帝彩云间，千里江陵一日还。两岸猿声啼不住，轻舟已过万重山。" }] },
    { "id": "tangshi-zengwanglun", "bookId": "tangshi", "title": "赠汪伦·李白", "order": 4, "segments": [{ "id": "tangshi-zengwanglun-1", "chapterId": "tangshi-zengwanglun", "order": 1, "text": "李白乘舟将欲行，忽闻岸上踏歌声。桃花潭水深千尺，不及汪伦送我情。" }] },
    { "id": "tangshi-huanghelousongmeng", "bookId": "tangshi", "title": "黄鹤楼送孟浩然之广陵·李白", "order": 5, "segments": [{ "id": "tangshi-huanghelousongmeng-1", "chapterId": "tangshi-huanghelousongmeng", "order": 1, "text": "故人西辞黄鹤楼，烟花三月下扬州。孤帆远影碧空尽，唯见长江天际流。" }] },
    { "id": "tangshi-wangtianmenshan", "bookId": "tangshi", "title": "望天门山·李白", "order": 6, "segments": [{ "id": "tangshi-wangtianmenshan-1", "chapterId": "tangshi-wangtianmenshan", "order": 1, "text": "天门中断楚江开，碧水东流至此回。两岸青山相对出，孤帆一片日边来。" }] },
    { "id": "tangshi-duzuojingtingshan", "bookId": "tangshi", "title": "独坐敬亭山·李白", "order": 7, "segments": [{ "id": "tangshi-duzuojingtingshan-1", "chapterId": "tangshi-duzuojingtingshan", "order": 1, "text": "众鸟高飞尽，孤云独去闲。相看两不厌，只有敬亭山。" }] },
    { "id": "tangshi-chunwang", "bookId": "tangshi", "title": "春望·杜甫", "order": 8, "segments": [{ "id": "tangshi-chunwang-1", "chapterId": "tangshi-chunwang", "order": 1, "text": "国破山河在，城春草木深。感时花溅泪，恨别鸟惊心。烽火连三月，家书抵万金。白头搔更短，浑欲不胜簪。" }] },
    { "id": "tangshi-jueju", "bookId": "tangshi", "title": "绝句·杜甫", "order": 9, "segments": [{ "id": "tangshi-jueju-1", "chapterId": "tangshi-jueju", "order": 1, "text": "两个黄鹂鸣翠柳，一行白鹭上青天。窗含西岭千秋雪，门泊东吴万里船。" }] },
    { "id": "tangshi-chunyexiyu", "bookId": "tangshi", "title": "春夜喜雨·杜甫", "order": 10, "segments": [{ "id": "tangshi-chunyexiyu-1", "chapterId": "tangshi-chunyexiyu", "order": 1, "text": "好雨知时节，当春乃发生。随风潜入夜，润物细无声。野径云俱黑，江船火独明。晓看红湿处，花重锦官城。" }] },
    { "id": "tangshi-wangyue", "bookId": "tangshi", "title": "望岳·杜甫", "order": 11, "segments": [{ "id": "tangshi-wangyue-1", "chapterId": "tangshi-wangyue", "order": 1, "text": "岱宗夫如何？齐鲁青未了。造化钟神秀，阴阳割昏晓。荡胸生曾云，决眦入归鸟。会当凌绝顶，一览众山小。" }] },
    { "id": "tangshi-denggao", "bookId": "tangshi", "title": "登高·杜甫", "order": 12, "segments": [{ "id": "tangshi-denggao-1", "chapterId": "tangshi-denggao", "order": 1, "text": "风急天高猿啸哀，渚清沙白鸟飞回。无边落木萧萧下，不尽长江滚滚来。万里悲秋常作客，百年多病独登台。艰难苦恨繁霜鬓，潦倒新停浊酒杯。" }] },
    { "id": "tangshi-yueyeyishedi", "bookId": "tangshi", "title": "月夜忆舍弟·杜甫", "order": 13, "segments": [{ "id": "tangshi-yueyeyishedi-1", "chapterId": "tangshi-yueyeyishedi", "order": 1, "text": "戍鼓断人行，边秋一雁声。露从今夜白，月是故乡明。有弟皆分散，无家问死生。寄书长不达，况乃未休兵。" }] },
    { "id": "tangshi-shuxiang", "bookId": "tangshi", "title": "蜀相·杜甫", "order": 14, "segments": [{ "id": "tangshi-shuxiang-1", "chapterId": "tangshi-shuxiang", "order": 1, "text": "丞相祠堂何处寻？锦官城外柏森森。映阶碧草自春色，隔叶黄鹂空好音。三顾频烦天下计，两朝开济老臣心。出师未捷身先死，长使英雄泪满襟。" }] },
    { "id": "tangshi-xiangsi", "bookId": "tangshi", "title": "相思·王维", "order": 15, "segments": [{ "id": "tangshi-xiangsi-1", "chapterId": "tangshi-xiangsi", "order": 1, "text": "红豆生南国，春来发几枝。愿君多采撷，此物最相思。" }] },
    { "id": "tangshi-luzhai", "bookId": "tangshi", "title": "鹿柴·王维", "order": 16, "segments": [{ "id": "tangshi-luzhai-1", "chapterId": "tangshi-luzhai", "order": 1, "text": "空山不见人，但闻人语响。返景入深林，复照青苔上。" }] },
    { "id": "tangshi-shanjuqiuming", "bookId": "tangshi", "title": "山居秋暝·王维", "order": 17, "segments": [{ "id": "tangshi-shanjuqiuming-1", "chapterId": "tangshi-shanjuqiuming", "order": 1, "text": "空山新雨后，天气晚来秋。明月松间照，清泉石上流。竹喧归浣女，莲动下渔舟。随意春芳歇，王孙自可留。" }] },
    { "id": "tangshi-songyuanershianxi", "bookId": "tangshi", "title": "送元二使安西·王维", "order": 18, "segments": [{ "id": "tangshi-songyuanershianxi-1", "chapterId": "tangshi-songyuanershianxi", "order": 1, "text": "渭城朝雨浥轻尘，客舍青青柳色新。劝君更尽一杯酒，西出阳关无故人。" }] },
    { "id": "tangshi-niaomingjian", "bookId": "tangshi", "title": "鸟鸣涧·王维", "order": 19, "segments": [{ "id": "tangshi-niaomingjian-1", "chapterId": "tangshi-niaomingjian", "order": 1, "text": "人闲桂花落，夜静春山空。月出惊山鸟，时鸣春涧中。" }] },
    { "id": "tangshi-fudeguyuancaosongbie", "bookId": "tangshi", "title": "赋得古原草送别·白居易", "order": 20, "segments": [{ "id": "tangshi-fudeguyuancaosongbie-1", "chapterId": "tangshi-fudeguyuancaosongbie", "order": 1, "text": "离离原上草，一岁一枯荣。野火烧不尽，春风吹又生。远芳侵古道，晴翠接荒城。又送王孙去，萋萋满别情。" }] },
    { "id": "tangshi-mujiangyin", "bookId": "tangshi", "title": "暮江吟·白居易", "order": 21, "segments": [{ "id": "tangshi-mujiangyin-1", "chapterId": "tangshi-mujiangyin", "order": 1, "text": "一道残阳铺水中，半江瑟瑟半江红。可怜九月初三夜，露似真珠月似弓。" }] },
    { "id": "tangshi-chunxiao", "bookId": "tangshi", "title": "春晓·孟浩然", "order": 22, "segments": [{ "id": "tangshi-chunxiao-1", "chapterId": "tangshi-chunxiao", "order": 1, "text": "春眠不觉晓，处处闻啼鸟。夜来风雨声，花落知多少。" }] },
    { "id": "tangshi-guorenzhuang", "bookId": "tangshi", "title": "过故人庄·孟浩然", "order": 23, "segments": [{ "id": "tangshi-guorenzhuang-1", "chapterId": "tangshi-guorenzhuang", "order": 1, "text": "故人具鸡黍，邀我至田家。绿树村边合，青山郭外斜。开轩面场圃，把酒话桑麻。待到重阳日，还来就菊花。" }] },
    { "id": "tangshi-dengguanquelou", "bookId": "tangshi", "title": "登鹳雀楼·王之涣", "order": 24, "segments": [{ "id": "tangshi-dengguanquelou-1", "chapterId": "tangshi-dengguanquelou", "order": 1, "text": "白日依山尽，黄河入海流。欲穷千里目，更上一层楼。" }] },
    { "id": "tangshi-liangzhouci", "bookId": "tangshi", "title": "凉州词·王之涣", "order": 25, "segments": [{ "id": "tangshi-liangzhouci-1", "chapterId": "tangshi-liangzhouci", "order": 1, "text": "黄河远上白云间，一片孤城万仞山。羌笛何须怨杨柳，春风不度玉门关。" }] },
    { "id": "tangshi-chusai", "bookId": "tangshi", "title": "出塞·王昌龄", "order": 26, "segments": [{ "id": "tangshi-chusai-1", "chapterId": "tangshi-chusai", "order": 1, "text": "秦时明月汉时关，万里长征人未还。但使龙城飞将在，不教胡马度阴山。" }] },
    { "id": "tangshi-furonglousongxinjian", "bookId": "tangshi", "title": "芙蓉楼送辛渐·王昌龄", "order": 27, "segments": [{ "id": "tangshi-furonglousongxinjian-1", "chapterId": "tangshi-furonglousongxinjian", "order": 1, "text": "寒雨连江夜入吴，平明送客楚山孤。洛阳亲友如相问，一片冰心在玉壶。" }] },
    { "id": "tangshi-shanxing", "bookId": "tangshi", "title": "山行·杜牧", "order": 28, "segments": [{ "id": "tangshi-shanxing-1", "chapterId": "tangshi-shanxing", "order": 1, "text": "远上寒山石径斜，白云生处有人家。停车坐爱枫林晚，霜叶红于二月花。" }] },
    { "id": "tangshi-qingming", "bookId": "tangshi", "title": "清明·杜牧", "order": 29, "segments": [{ "id": "tangshi-qingming-1", "chapterId": "tangshi-qingming", "order": 1, "text": "清明时节雨纷纷，路上行人欲断魂。借问酒家何处有？牧童遥指杏花村。" }] },
    { "id": "tangshi-wangdongting", "bookId": "tangshi", "title": "望洞庭·刘禹锡", "order": 30, "segments": [{ "id": "tangshi-wangdongting-1", "chapterId": "tangshi-wangdongting", "order": 1, "text": "湖光秋月两相和，潭面无风镜未磨。遥望洞庭山水翠，白银盘里一青螺。" }] },
    { "id": "tangshi-yeyujibei", "bookId": "tangshi", "title": "夜雨寄北·李商隐", "order": 31, "segments": [{ "id": "tangshi-yeyujibei-1", "chapterId": "tangshi-yeyujibei", "order": 1, "text": "君问归期未有期，巴山夜雨涨秋池。何当共剪西窗烛，却话巴山夜雨时。" }] },
    { "id": "tangshi-yongliu", "bookId": "tangshi", "title": "咏柳·贺知章", "order": 32, "segments": [{ "id": "tangshi-yongliu-1", "chapterId": "tangshi-yongliu", "order": 1, "text": "碧玉妆成一树高，万条垂下绿丝绦。不知细叶谁裁出，二月春风似剪刀。" }] },
    { "id": "tangshi-saixiaqu", "bookId": "tangshi", "title": "塞下曲·卢纶", "order": 33, "segments": [{ "id": "tangshi-saixiaqu-1", "chapterId": "tangshi-saixiaqu", "order": 1, "text": "月黑雁飞高，单于夜遁逃。欲将轻骑逐，大雪满弓刀。" }] },
    { "id": "tangshi-jiangxue", "bookId": "tangshi", "title": "江雪·柳宗元", "order": 34, "segments": [{ "id": "tangshi-jiangxue-1", "chapterId": "tangshi-jiangxue", "order": 1, "text": "千山鸟飞绝，万径人踪灭。孤舟蓑笠翁，独钓寒江雪。" }] },
    { "id": "tangshi-youziyin", "bookId": "tangshi", "title": "游子吟·孟郊", "order": 35, "segments": [{ "id": "tangshi-youziyin-1", "chapterId": "tangshi-youziyin", "order": 1, "text": "慈母手中线，游子身上衣。临行密密缝，意恐迟迟归。谁言寸草心，报得三春晖。" }] },
    { "id": "tangshi-fengqiaoyebo", "bookId": "tangshi", "title": "枫桥夜泊·张继", "order": 36, "segments": [{ "id": "tangshi-fengqiaoyebo-1", "chapterId": "tangshi-fengqiaoyebo", "order": 1, "text": "月落乌啼霜满天，江枫渔火对愁眠。姑苏城外寒山寺，夜半钟声到客船。" }] }
  ]
}
