{
  "description": "通假字映射表：列出古文中的通假字及其本字、说明，用于注音与释义。",
  "entries": [
    { "char": "说", "original": "悦", "note": "通‘悦’，喜悦。例：学而时习之，不亦说乎", "source": "《论语·学而》" },
    { "char": "女", "original": "汝", "note": "通‘汝’，你。例：女弗能救与", "source": "《论语·八佾》" },
    { "char": "共", "original": "拱", "note": "通‘拱’，环绕。例：居其所而众星共之", "source": "《论语·为政》" },
    { "char": "亡", "original": "无", "note": "通‘无’，没有。例：不如诸夏之亡也", "source": "《论语·八佾》" },
    { "char": "错", "original": "措", "note": "通‘措’，安置。例：举直错诸枉，则民服", "source": "《论语·为政》" },
    { "char": "阙", "original": "缺", "note": "通‘缺’，缺失。例：多闻阙疑，慎言其余", "source": "《论语·为政》" },
    { "char": "知", "original": "智", "note": "通‘智’，智慧。例：知之为知之，不知为不知，是知也", "source": "《论语·为政》" },
    { "char": "弟", "original": "悌", "note": "通‘悌’，敬爱兄长。例：其为人也孝弟", "source": "《论语·学而》" },
    { "char": "道", "original": "导", "note": "通‘导’，引导。例：道之以政，齐之以刑", "source": "《论语·为政》" },
    { "char": "辟", "original": "避", "note": "通‘避’，躲避。例：驱而纳诸罟擭陷阱之中，而莫之知辟也", "source": "《中庸》" },
    { "char": "辟", "original": "僻", "note": "通‘僻’，偏邪。例：辟则为天下僇矣", "source": "《大学》" },
    { "char": "见", "original": "现", "note": "通‘现’，显现。例：见乎蓍龟，动乎四体", "source": "《中庸》" },
    { "char": "倍", "original": "背", "note": "通‘背’，背叛。例：上恤孤而民不倍", "source": "《大学》" },
    { "char": "蚤", "original": "早", "note": "通‘早’，及早。例：君子未有不如此而蚤有誉于天下者也", "source": "《中庸》" },
    { "char": "帅", "original": "率", "note": "通‘率’，率领。例：尧舜帅天下以仁，而民从之", "source": "《大学》" },
    { "char": "缪", "original": "谬", "note": "通‘谬’，错误。例：考诸三王而不缪", "source": "《中庸》" },
    { "char": "队", "original": "坠", "note": "通‘坠’，坠落。例：日月所照，霜露所队", "source": "《中庸》" },
    { "char": "被", "original": "披", "note": "通‘披’，穿着。例：是以圣人被褐怀玉", "source": "《道德经》" },
    { "char": "曾", "original": "层", "note": "通‘层’，层叠。例：荡胸生曾云，决眦入归鸟", "source": "《望岳》" },
    { "char": "内", "original": "纳", "note": "通‘纳’，接纳。例：勿内于诸侯（接纳）", "source": "通用文言" },
    { "char": "卒", "original": "猝", "note": "通‘猝’，突然。例：卒然问曰", "source": "《孟子》" },
    { "char": "无", "original": "毋", "note": "通‘毋’，不要。例：无友不如己者", "source": "《论语·学而》" },
    { "char": "匪", "original": "非", "note": "通‘非’，不是。例：匪我愆期，子无良媒", "source": "《诗经》" },
    { "char": "华", "original": "花", "note": "通‘花’，花朵。例：山有扶苏，隰有荷华", "source": "《诗经》" },
    { "char": "反", "original": "返", "note": "通‘返’，返回。例：迷途其未远，觉今是而昨非（反通返）", "source": "《归去来兮辞》" },
    { "char": "振", "original": "震", "note": "通‘震’，震动。例：振河海而不泄", "source": "《中庸》" },
    { "char": "菑", "original": "灾", "note": "通‘灾’，灾祸。例：菑害并至，虽有善者，亦无如之何矣", "source": "《大学》" },
    { "char": "諟", "original": "是", "note": "通‘是’，此、这。例：顾諟天之明命", "source": "《大学》" },
    { "char": "菉", "original": "绿", "note": "通‘绿’，绿色。例：瞻彼淇澳，菉竹猗猗", "source": "《大学》" },
    { "char": "缗", "original": "绵", "note": "通‘绵’，绵蛮（鸟鸣声）。例：缗蛮黄鸟，止于丘隅", "source": "《大学》" },
    { "char": "於戏", "original": "呜呼", "note": "通‘呜呼’，叹词。例：於戏！前王不忘", "source": "《大学》" },
    { "char": "帑", "original": "孥", "note": "通‘孥’，妻子儿女。例：乐尔妻帑", "source": "《中庸》" },
    { "char": "壹", "original": "一", "note": "通‘一’，一概、一律。例：壹是皆以修身为本", "source": "《大学》" },
    { "char": "齐", "original": "斋", "note": "通‘斋’，斋戒。例：齐明盛服，以承祭祀", "source": "《中庸》" },
    { "char": "没", "original": "殁", "note": "通‘殁’，终、去世。例：此以没世不忘也", "source": "《大学》" },
    { "char": "谿", "original": "溪", "note": "通‘溪’，山溪。例：知其雄，守其雌，为天下谿", "source": "《道德经》" },
    { "char": "陈", "original": "阵", "note": "通‘阵’，列阵。例：陈兵（列阵）", "source": "通用文言" },
    { "char": "罢", "original": "疲", "note": "通‘疲’，疲惫。例：罢夫羸老易子而咬其骨", "source": "《论积贮疏》" },
    { "char": "盖", "original": "盍", "note": "通‘盍’，何不。例：盖亦反其本矣", "source": "《孟子》" },
    { "char": "乡", "original": "向", "note": "通‘向’，先前、朝向。例：乡为身死而不受", "source": "《孟子》" },
    { "char": "逝", "original": "誓", "note": "通‘誓’，发誓。例：逝将去女，适彼乐土", "source": "《诗经》" },
    { "char": "颁", "original": "斑", "note": "通‘斑’，花白。例：颁白者不负戴于道路矣", "source": "《孟子》" },
    { "char": "衡", "original": "横", "note": "通‘横’，横逆、梗塞。例：困于心衡于虑而后作", "source": "《孟子》" },
    { "char": "拂", "original": "弼", "note": "通‘弼’，辅佐。例：入则无法家拂士", "source": "《孟子》" },
    { "char": "暴", "original": "曝", "note": "通‘曝’，曝晒。例：虽有槁暴，不复挺者", "source": "《劝学》" },
    { "char": "輮", "original": "煣", "note": "通‘煣’，用火烘木使之弯曲。例：木直中绳，輮以为轮", "source": "《劝学》" },
    { "char": "生", "original": "性", "note": "通‘性’，资质、禀赋。例：君子生非异也，善假于物也", "source": "《劝学》" },
    { "char": "契", "original": "锲", "note": "通‘锲’，刻。例：剑自舟中坠于水，遽契其舟", "source": "《刻舟求剑》" }
  ]
}
