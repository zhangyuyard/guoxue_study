# 签名证书（泄露 = 应用可被他人冒名更新）
*.keystore
!android/app/debug.keystore

# 构建产物
android/app/build/
android/build/
android/.gradle/
android/captures/
android/local.properties
# NDK/CMake 原生构建目录（2026-10-14 实测 151MB：Debug/RelWithDebInfo/tools）
# ⚠ 此前漏配 ⇒ `git status` 里以未跟踪项出现，`git add -A` 会把它入库。
# 判据＝`git check-ignore -v --no-index android/app/.cxx/` 应有输出（须带正对照：
# 同命令对 src/ 下路径应 exit=1）——空输出易读成「已忽略」（假 0）。
android/app/.cxx/
ios/Pods/
ios/build/
ios/*.xcworkspace/xcuserdata/

# 发布构建产物（体积大且每次打包都会变，仓库只留源码与文档）
deliverables/android/

# 依赖
node_modules/

# 系统 / 编辑器
.DS_Store
.history/
*.log

# 项目本地工作记忆 / 工作区元数据（含 agent 记忆、过程账本；不随仓共享）
.workbuddy/

# TS 增量构建信息
*.tsbuildinfo

# ── 证据 / 过程产物区（默认全部忽略）─────────────────────────────
# deliverables/ 是「验证证据 + 分析报告 + 轮次记录」的落地区，每轮都会新增，
# 且含大体积 raw logcat 文本与打包产物（2026-09-17 实测：_archive-2026-09-17
# 775 MB、verification-r50 66 MB）。仓库只保留**已纳入版本控制的文档区**。
# 需要提交其中某一份时，显式 `git add -f <path>`。
deliverables/*
!deliverables/software-company/

# 轮次过程记录与验证证据（显式列出以防白名单被误扩）
deliverables/verification-r*/
deliverables/arch-*/
deliverables/_archive-*/
deliverables/r*-*/

# 分析报告与过程账本（随时间失效，不作为项目资产）
deliverables/ARCH-*.md
deliverables/TASK-LEDGER.md
deliverables/*measurement-plan.md
